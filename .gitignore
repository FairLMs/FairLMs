# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/

# Virtual envs / tooling
.venv/
venv/
.env
.python-version
.pytest_cache/
.mypy_cache/
.ruff_cache/
.DS_Store

